{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "Where a value was read: the page (numbered from 1) and the literal text.",
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "$ref": "#/$defs/NonBlankText"
        }
      },
      "required": [
        "page",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CurrencyCode": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "ExtractedField_CurrencyCode_": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurrencyCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Citation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "value"
      ],
      "title": "ExtractedField[CurrencyCode]",
      "type": "object"
    },
    "ExtractedField_IsoDate_": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Citation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "value"
      ],
      "title": "ExtractedField[IsoDate]",
      "type": "object"
    },
    "ExtractedField_Money_": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Citation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "value"
      ],
      "title": "ExtractedField[Money]",
      "type": "object"
    },
    "ExtractedField_str_": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Citation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "value"
      ],
      "title": "ExtractedField[str]",
      "type": "object"
    },
    "IsoDate": {
      "format": "date",
      "type": "string"
    },
    "Money": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "NonBlankText": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Fields of one receipt. Every field is either a value cited from the\ndocument or null with the reason it is missing; never a guess.",
  "properties": {
    "company": {
      "$ref": "#/$defs/ExtractedField_str_",
      "description": "Name of the seller as printed."
    },
    "address": {
      "$ref": "#/$defs/ExtractedField_str_",
      "description": "Address of the seller as printed."
    },
    "date": {
      "$ref": "#/$defs/ExtractedField_IsoDate_",
      "description": "Issue date as YYYY-MM-DD; the quote keeps it as printed."
    },
    "total": {
      "$ref": "#/$defs/ExtractedField_Money_",
      "description": "Final amount paid, including tax, as a decimal number."
    },
    "currency": {
      "$ref": "#/$defs/ExtractedField_CurrencyCode_",
      "description": "ISO 4217 code (e.g. MYR for 'RM'); null when not printed."
    }
  },
  "required": [
    "company",
    "address",
    "date",
    "total",
    "currency"
  ],
  "title": "Receipt",
  "type": "object"
}
