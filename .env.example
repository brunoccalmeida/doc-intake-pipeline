# Copy to .env (ignored by Git) and adjust. Real environment variables win over this file.
# Every variable is validated at startup (core/config.py): a bad value stops the run.

# DEBUG | INFO | WARNING | ERROR | CRITICAL
DOC_INTAKE_LOG_LEVEL=INFO

# Directory holding Tesseract's eng.traineddata ("uv run poe fetch-tessdata" puts it here)
DOC_INTAKE_TESSDATA_DIR=.cache/tessdata

# Clone of the private recordings repository the eval replays (docs/DATA.md)
DOC_INTAKE_RECORDINGS_DIR=.cache/recordings

# LLM provider for extraction: claude | openai
DOC_INTAKE_PROVIDER=claude
# Models (defaults: each vendor's recommended general-purpose model)
# DOC_INTAKE_CLAUDE_MODEL=claude-opus-5-5
# DOC_INTAKE_OPENAI_MODEL=gpt-6.2-astra
# API key of the provider in use (only the selected one is required)
DOC_INTAKE_ANTHROPIC_API_KEY=
DOC_INTAKE_OPENAI_API_KEY=
# Claude only, instead of the key above (set one, not both): an "ant auth login"
# profile: OAuth sign-in, no API key to create or copy here (docs/ARCHITECTURE.md D13)
# DOC_INTAKE_ANTHROPIC_PROFILE=default
# Retries after the first call when the answer fails schema validation
DOC_INTAKE_MAX_RETRIES=2
# Acceptance policy written by "uv run poe calibrate": the image-read fields it
# accepts skip review, except an audit sample (deploy/README.md). Unset, every
# value read from the page image goes to review.
# DOC_INTAKE_ACCEPTANCE_POLICY=/srv/doc-intake/policy.json
