{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "Where a value was read: the page (numbered from 1), the source and the literal text.\n\nsource \"text\": the quote is copied from the page's text. source \"image\": the\nquote is the text as printed on the page image, used only where the page's\ntext misreads or misses it.",
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/QuoteSource"
        },
        "quote": {
          "$ref": "#/$defs/NonBlankText"
        }
      },
      "required": [
        "page",
        "source",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CurrencyCode": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "ExtractedField_CurrencyCode_": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurrencyCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Citation"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankText"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "citation",
        "reason"
      ],
      "title": "ExtractedField[CurrencyCode]",
      "type": "object"
    },
    "ExtractedField_IsoDate_": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Citation"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankText"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "citation",
        "reason"
      ],
      "title": "ExtractedField[IsoDate]",
      "type": "object"
    },
    "ExtractedField_Money_": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Citation"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
