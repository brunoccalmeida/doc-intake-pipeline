    "IsoDate": {
      "format": "date",
      "type": "string"
    },
    "Money": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "NonBlankText": {
      "pattern": "\\S",
      "type": "string"
    },
    "QuoteSource": {
      "enum": [
        "text",
        "image"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Fields of one invoice. Every field is either a value cited from the\ndocument or null with the reason it is missing; never a guess.",
  "properties": {
    "number": {
      "$ref": "#/$defs/ExtractedField_str_",
      "description": "Invoice number as printed, without label."
    },
    "date": {
      "$ref": "#/$defs/ExtractedField_IsoDate_",
      "description": "Issue date as YYYY-MM-DD; the quote keeps it as printed."
    },
    "due_date": {
      "$ref": "#/$defs/ExtractedField_IsoDate_",
      "description": "Payment due date as YYYY-MM-DD; null when not printed."
    },
    "seller_name": {
      "$ref": "#/$defs/ExtractedField_str_",
      "description": "Name of the seller as printed."
    },
    "seller_address": {
      "$ref": "#/$defs/ExtractedField_str_",
      "description": "Address of the seller as printed, without label."
    },
    "subtotal": {
      "$ref": "#/$defs/ExtractedField_Money_",
      "description": "Subtotal before tax, as a decimal number; null when not printed."
    },
    "tax": {
      "$ref": "#/$defs/ExtractedField_Money_",
      "description": "All the tax as one printed amount; null when not printed as one amount."
    },
    "total": {
      "$ref": "#/$defs/ExtractedField_Money_",
      "description": "Final amount payable, as a decimal number; null when not printed."
    },
    "currency": {
      "$ref": "#/$defs/ExtractedField_CurrencyCode_",
      "description": "ISO 4217 code printed with the amounts; null for '$' alone or none."
    }
  },
  "required": [
    "number",
    "date",
    "due_date",
    "seller_name",
    "seller_address",
    "subtotal",
    "tax",
    "total",
    "currency"
  ],
  "title": "Invoice",
  "type": "object"
}
